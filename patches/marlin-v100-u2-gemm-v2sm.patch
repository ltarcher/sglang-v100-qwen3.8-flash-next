+// Small-M variant of the v2 kernel: identical compute and epilogue, but the
+// B-word / A tile pipeline is 3-deep instead of 2, so two stages are in
+// flight while one computes. Decode shapes (M<=16, one padded 32-row block
+// per routed expert) are latency-bound in the v2 kernel: each CTA keeps only
+// one stage's loads outstanding, capping effective HBM bandwidth near
+// 250-300 GB/s regardless of M (measured on GLM w13/w2, 4x V100, offline
+// M-sweep 2026-10-05). Doubling the in-flight stage count is the first,
+// compute-invariant lever; smem/CTA rises 12.25KB -> 18.4KB (5 CTAs/SM).
+__global__ void __launch_bounds__(128) sm70_u2_gemm_v2sm_kernel(
+    const half* __restrict__ A, half* __restrict__ C,
+    const uint32_t* __restrict__ Bt, const half* __restrict__ scales,
+    const int32_t* __restrict__ sorted_ids,
+    const int32_t* __restrict__ expert_ids,
+    const int32_t* __restrict__ num_post_padded,
+    const float* __restrict__ topk_weights, bool mul_topk_weights, int top_k,
+    int size_n, int size_k, int num_groups, int group_size,
+    int expanded_cnt) {
+  const int block_idx = blockIdx.x;
+  const int padded = *num_post_padded;
+  if (block_idx * 32 >= padded) return;
+  const int expert = expert_ids[block_idx];
+  if (expert < 0) return;
+
+  const int n_tile = blockIdx.y * 128;
+  const int lane = threadIdx.x & 31;
+  const int warp = threadIdx.x >> 5;
+  const int q = (lane >> 2) & 3;
+  const int rowq = q >> 1, colq = q & 1;
+  const int hgt = lane >= 16;
+
+  const int kwords = size_k >> 4;
+  const int nk = size_k >> 6;  // 64-k blocks
+  const uint32_t* Bt_e = Bt + (size_t)expert * kwords * size_n;
+  const half* sc_e = scales + (size_t)expert * num_groups * size_n;
+
+  const int b_col0 = n_tile + warp * 32 + 8 * colq + (lane & 3) + 4 * hgt;
+  const int b_col1 = b_col0 + 16;
+  const int a_row0 = 8 * rowq + (lane & 3) + 4 * hgt;
+  const int a_row1 = 16 + a_row0;
+  const int sorted_base = block_idx * 32;
+
+  __shared__ half As[3][A_BUF_HALFS];
+  __shared__ uint32_t Bs[3][4 * B_KG_WORDS];
+
+  auto stage = [&](int k_base, int buf) {
+    half* dst = As[buf];
+#pragma unroll
+    for (int p = 0; p < 2; ++p) {
+      const int idx = threadIdx.x + p * 128;
+      const int row = idx >> 3;
+      const int c = idx & 7;
+      const int route = sorted_base + row;
+      int sid = -1;
+      if (route < padded) sid = sorted_ids[route];
+      const bool valid = sid >= 0 && sid < expanded_cnt;
+      const int token_row = valid ? sid / top_k : 0;
+      const uint4 v =
+          *reinterpret_cast<const uint4*>(A + (size_t)token_row * size_k +
+                                          k_base + c * 8);
+      *reinterpret_cast<uint4*>(dst + c * A_CHUNK_HALFS + row * 8) = v;
+    }
+    const int i = threadIdx.x >> 5;
+    const int u = threadIdx.x & 31;
+    const uint4 w = *reinterpret_cast<const uint4*>(
+        Bt_e + (size_t)((k_base >> 4) + i) * size_n + n_tile + u * 4);
+    *reinterpret_cast<uint4*>(Bs[buf] + i * B_KG_WORDS + u * 4) = w;
+  };
+
+  stage(0, 0);
+  if (nk > 1) stage(64, 1);
+  __syncthreads();
+
+  float d[2][2][8];
+#pragma unroll
+  for (int mi = 0; mi < 2; ++mi)
+#pragma unroll
+    for (int ni = 0; ni < 2; ++ni)
+#pragma unroll
+      for (int i = 0; i < 8; ++i) d[mi][ni][i] = 0.f;
+
+  for (int kb = 0; kb < nk; ++kb) {
+    if (kb + 2 < nk) stage((kb + 2) << 6, (kb + 2) % 3);
+
+    const int buf = kb % 3;
+    const int k_base = kb << 6;
+    const uint32_t* Bsk = Bs[buf];
+    const int j0 = b_col0 - n_tile;
+    half2 s20, s21, m20, m21;
+#pragma unroll
+    for (int kg = 0; kg < 4; ++kg) {
+      const int kk = (k_base >> 4) + kg;
+      if (((kk * 16) & (group_size - 1)) == 0) {
+        const int g = (kk * 16) / group_size;
+        const half s0 = sc_e[g * size_n + b_col0];
+        const half s1 = sc_e[g * size_n + b_col1];
+        s20 = __half2half2(s0);
+        s21 = __half2half2(s1);
+        m20 = __half2half2(__hmul(__float2half(-1.4501953125f), s0));
+        m21 = __half2half2(__hmul(__float2half(-1.4501953125f), s1));
+      }
+      const uint32_t word0 = Bsk[kg * B_KG_WORDS + j0];
+      const uint32_t word1 = Bsk[kg * B_KG_WORDS + j0 + 16];
+
+#pragma unroll
+      for (int pair = 0; pair < 2; ++pair) {
+        const int kt = (kg << 2) + (pair << 1);
+        const int c = kt >> 1;
+        const uint4 af0 =
+            *reinterpret_cast<const uint4*>(As[buf] + c * A_CHUNK_HALFS +
+                                            a_row0 * 8);
+        const uint4 af1 =
+            *reinterpret_cast<const uint4*>(As[buf] + c * A_CHUNK_HALFS +
+                                            a_row1 * 8);
+        const unsigned a0[2] = {af0.x, af0.y};
+        const unsigned a1[2] = {af0.z, af0.w};
+        const unsigned a2[2] = {af1.x, af1.y};
+        const unsigned a3[2] = {af1.z, af1.w};
+        const half2 b020 = u2_deq(word0, kt & 3, 0, s20);
+        const half2 b230 = u2_deq(word0, kt & 3, 1, s20);
+        const half2 b450 = u2_deq(word0, (kt + 1) & 3, 0, s20);
+        const half2 b670 = u2_deq(word0, (kt + 1) & 3, 1, s20);
+        const half2 b021 = u2_deq(word1, kt & 3, 0, s21);
+        const half2 b231 = u2_deq(word1, kt & 3, 1, s21);
+        const half2 b451 = u2_deq(word1, (kt + 1) & 3, 0, s21);
+        const half2 b671 = u2_deq(word1, (kt + 1) & 3, 1, s21);
+        const unsigned breg0[2][2] = {
+            {*reinterpret_cast<const unsigned*>(&b020),
+             *reinterpret_cast<const unsigned*>(&b230)},
+            {*reinterpret_cast<const unsigned*>(&b450),
+             *reinterpret_cast<const unsigned*>(&b670)}};
+        const unsigned breg1[2][2] = {
+            {*reinterpret_cast<const unsigned*>(&b021),
+             *reinterpret_cast<const unsigned*>(&b231)},
+            {*reinterpret_cast<const unsigned*>(&b451),
+             *reinterpret_cast<const unsigned*>(&b671)}};
+        mma_m8n8k4(a0, breg0[0], d[0][0], d[0][0]);
+        mma_m8n8k4(a0, breg1[0], d[0][1], d[0][1]);
+        mma_m8n8k4(a1, breg0[1], d[0][0], d[0][0]);
+        mma_m8n8k4(a1, breg1[1], d[0][1], d[0][1]);
+        mma_m8n8k4(a2, breg0[0], d[1][0], d[1][0]);
+        mma_m8n8k4(a2, breg1[0], d[1][1], d[1][1]);
+        mma_m8n8k4(a3, breg0[1], d[1][0], d[1][0]);
+        mma_m8n8k4(a3, breg1[1], d[1][1], d[1][1]);
+      }
+    }
+    __syncthreads();
+  }
+
+  const int epi_r0 = 8 * rowq + (lane & 1) + 4 * hgt;
+  const int epi_c0 = n_tile + warp * 32 + 8 * colq + (lane & 2);
+#pragma unroll
+  for (int mi = 0; mi < 2; ++mi)
+#pragma unroll
+    for (int ni = 0; ni < 2; ++ni)
+#pragma unroll
+      for (int p = 0; p < 4; ++p) {
+        const int row = sorted_base + 16 * mi + epi_r0 + (p & 1) * 2;
+        const int col = epi_c0 + 16 * ni + (p & 2) * 2;
+        int sid = -1;
+        if (row < padded) sid = sorted_ids[row];
+        if (sid >= 0 && sid < expanded_cnt) {
+          const float w = mul_topk_weights ? topk_weights[sid] : 1.0f;
+          *reinterpret_cast<half2*>(C + (size_t)sid * size_n + col) =
+              __floats2half2_rn(d[mi][ni][2 * p] * w, d[mi][ni][2 * p + 1] * w);
+        }
+      }
+}
+
 }  // namespace
 
+void sm70_u2_gemm_v2sm(
+    const at::Tensor& a, at::Tensor& c, const at::Tensor& b_qweight_t,
+    const at::Tensor& b_scales, const at::Tensor& sorted_token_ids,
+    const at::Tensor& expert_ids, const at::Tensor& num_tokens_past_padded,
+    const at::Tensor& topk_weights, int64_t moe_block_size, int64_t top_k,
+    bool mul_topk_weights, int64_t size_m, int64_t size_n, int64_t size_k,
+    int64_t group_size) {
+  TORCH_CHECK(a.is_cuda() && c.is_cuda() && b_qweight_t.is_cuda() &&
+                  b_scales.is_cuda() && sorted_token_ids.is_cuda() &&
+                  expert_ids.is_cuda() && num_tokens_past_padded.is_cuda(),
+              "sm70_u2_gemm_v2sm: all tensors must be CUDA");
+  TORCH_CHECK(a.scalar_type() == at::ScalarType::Half &&
+                  c.scalar_type() == at::ScalarType::Half &&
+                  b_scales.scalar_type() == at::ScalarType::Half,
+              "sm70_u2_gemm_v2sm: a, c, b_scales must be fp16");
+  TORCH_CHECK(b_qweight_t.scalar_type() == at::ScalarType::Int,
+              "sm70_u2_gemm_v2sm: b_q_weight must be int32");
+  TORCH_CHECK(a.is_contiguous() && c.is_contiguous() &&
+                  b_qweight_t.is_contiguous() && b_scales.is_contiguous() &&
+                  sorted_token_ids.is_contiguous() &&
+                  expert_ids.is_contiguous(),
+              "sm70_u2_gemm_v2sm: tensors must be contiguous");
+  TORCH_CHECK(size_k % 64 == 0, "sm70_u2_gemm_v2sm requires K % 64 == 0, got ",
+              size_k);
+  TORCH_CHECK(size_n % 128 == 0,
+              "sm70_u2_gemm_v2sm requires N % 128 == 0, got ", size_n);
+  TORCH_CHECK(group_size == 32 || group_size == 64 || group_size == 128,
+              "sm70_u2_gemm_v2sm requires group size in {32, 64, 128}, got ",
+              group_size);
+  TORCH_CHECK(moe_block_size == 32,
+              "sm70_u2_gemm_v2sm requires moe_block_size == 32, got ",
+              moe_block_size);
+
+  const at::cuda::CUDAGuard device_guard(a.device());
+  const int num_groups = size_k / group_size;
+  const int expanded_cnt = size_m * top_k;
+  const int tiles = sorted_token_ids.numel() / moe_block_size;
+
+  dim3 grid(tiles, size_n / 128);
+  auto stream = at::cuda::getCurrentCUDAStream();
+  sm70_u2_gemm_v2sm_kernel<<<grid, 128, 0, stream>>>(
+      reinterpret_cast<const half*>(a.data_ptr()),
+      reinterpret_cast<half*>(c.data_ptr()),
+      reinterpret_cast<const uint32_t*>(b_qweight_t.data_ptr<int>()),
+      reinterpret_cast<const half*>(b_scales.data_ptr()),
+      sorted_token_ids.data_ptr<int>(), expert_ids.data_ptr<int>(),
+      num_tokens_past_padded.data_ptr<int>(), topk_weights.data_ptr<float>(),
+      mul_topk_weights, top_k, size_n, size_k, num_groups, group_size,
+      expanded_cnt);
+  C10_CUDA_KERNEL_LAUNCH_CHECK();
+}
